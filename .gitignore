# Python
__pycache__/
*.pyc
*.pyo
*.pyd

# Generated/synthetic training images -- reproducible from
# datasets/synthesis/build_dataset.py + synthesize_*.py given the source
# crops and manifest.csv, so not worth tracking (thousands of small PNGs).
datasets/synthesis/images/

# Hand-drawn source character crops -- NOT reproducible (original manual
# work), but git is a poor fit for thousands of small binary image files
# regardless of irreplaceability. Back these up separately (cloud
# storage / external drive) -- do not rely on this repo as their backup.
datasets/aksara_sunda_full/
datasets/aksara_sunda/
datasets/rarangken_angka_collection/_backup_before_renormalize/
datasets/rarangken_angka_collection/_backup_before_thinning/
datasets/rarangken_angka_collection/worksheets/
datasets/rarangken_angka_collection/_demo_*.png

# Legacy/superseded baseline dataset images (manifest kept)
training/baseline_data/images/

# Model checkpoints -- large binary .pt files, regenerable by rerunning
# training/train_crnn.py against the (locally available) image data.
training/checkpoints/

# TensorBoard event files and ad-hoc run logs -- ephemeral, regenerated
# every run, not meaningful outside the machine that produced them.
training/runs/
training/*.log

# Third-party font files used for font-rendered synthesis (Caringin,
# Gede Pangrango: CC BY-NC-ND; others of unclear/community license) --
# not ours to redistribute. See DATA_PIPELINE.md for download sources;
# datasets/rarangken_angka_collection/fonts/NotoSansSundanese.ttf (OFL,
# genuinely redistributable) is intentionally NOT covered by this rule.
datasets/rarangken_angka_collection/fonts/font_synthesis/

# corpus.db backup snapshots -- git itself is the recovery mechanism
# once a change is committed; these were pre-commit manual safety copies.
datasets/synthesis/*.bak

# Ad-hoc visual validation renders (augmentation/jitter sanity checks) --
# throwaway inspection images, not meaningful outside the session that
# produced them.
datasets/rarangken_angka_collection/jitter_test/

# Test images of unknown/external provenance pasted in during OOD
# generalization testing -- not ours to redistribute; see RESULTS.md /
# CLASS_IMBALANCE_PLAN.md for the findings derived from them.
/image.png
/image copy.png

# OS / editor cruft
.DS_Store
Thumbs.db
.vscode/
.idea/
